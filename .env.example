# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic. Server-side only, never expose to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: a stronger model for Anki cards the fact-check isn't sure about. Unset means ANTHROPIC_MODEL.
ANTHROPIC_REVIEW_MODEL=

# Voyage AI embeddings for notes, stones and question matching (voyageai.com).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# Optional. Google Books works without a key but is heavily rate limited.
GOOGLE_BOOKS_API_KEY=

# Android app (Phase 4). The address of your hosted web app; the phone calls its API here.
# Leave empty for the web app itself. Must be https:// for a phone build.
NEXT_PUBLIC_API_BASE_URL=

# Optional. Extra origins (comma separated) allowed to call the API from a browser, on top of the
# Android app's own (https://localhost). Example for testing on your Wi-Fi: http://192.168.1.20:3000
CORS_ALLOWED_ORIGINS=
